# 서버 포트 및 경로 설정
PORT=3080
DB_PATH=/data/sync_state.db
TMP_DIR=/tmp/mybox_sync
TZ=Asia/Seoul

# 입력 소스 1: 네이버 MYBOX Open API
MYBOX_PAT=
MYBOX_API_BASE=https://apis.naver.com/mybox

# 입력 소스 2: Google Drive API v3
GDRIVE_ACCESS_TOKEN=
GDRIVE_API_BASE=https://www.googleapis.com/drive/v3

# 입력 소스 3: Google Takeout 로컬 아카이브 디렉터리
TAKEOUT_DIR=/data/takeout

# 출력 타겟 1: 셀프호스팅 Immich (사진·동영상)
IMMICH_URL=http://192.168.0.10:2283
IMMICH_API_KEY=

# 출력 타겟 2: 셀프호스팅 Nextcloud WebDAV (일반 문서·아카이브)
ENABLE_NEXTCLOUD=true
NEXTCLOUD_URL=http://192.168.0.10:8080
NEXTCLOUD_USER=admin
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_BASE_DIR=/Cloud-Backup

# 성능, 재시도 및 주기적 자동 동기화 제어 (0 = 수동 실행 전용, 예: 360 = 6시간마다 자동 증분 스캔 & 동기화)
CONCURRENCY=3
RATE_LIMIT_RPS=5.0
MAX_RETRIES=3
SYNC_INTERVAL_MINUTES=0
